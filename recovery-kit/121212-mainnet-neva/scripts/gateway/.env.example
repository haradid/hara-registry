# Postgres
POSTGRES_DB=hara_gateway
POSTGRES_USER=hara_gw
POSTGRES_PASSWORD=change-me-strong-password

# JWT / dashboard
JWT_SECRET=change-me-32-byte-random-hex
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password

# HAProxy upstream — HAProxy runs on validator1 (<MAINNET_V1_AWS_IP>), a DIFFERENT
# host from this gateway (deployed on validator2+corp1+write2, Azure) — real
# network hop, not host.docker.internal like cloud_1's co-located pattern.
HAPROXY_HOST=<MAINNET_V1_AWS_IP>
HAPROXY_WRITE_HTTP_PORT=5797
HAPROXY_WRITE_WS_PORT=5798
HAPROXY_CALL_HTTP_PORT=5799
HAPROXY_ARCHIVE_HTTP_PORT=5800

# Public URLs (for dashboard display / docs) — this VM's own public IP
GATEWAY_PUBLIC_HTTP_URL=http://<MAINNET_V2_OLD_IP>:4000
GATEWAY_PUBLIC_WS_URL=ws://<MAINNET_V2_OLD_IP>:4001
GATEWAY_PUBLIC_URL=http://<MAINNET_V2_OLD_IP>:4002

# Misc
NODE_ENV=production
CHAIN_ID=121212
COOKIE_SECURE=false

# Faucet (ported from the standalone hara-faucet-app Go service)
FAUCET_RPC_URL=http://<MAINNET_V1_AWS_IP>:5797
FAUCET_CHAIN_ID=121212
FAUCET_WHITELIST_CONTRACT=0x0000000000000000000000000000000000000000
FAUCET_EXPLORER_URL=https://explorer.registry.haratoken.app
FAUCET_ALLOCATION_WEI=2000000000000000000
FAUCET_ALLOCATION_DISPLAY=2 HARA
FAUCET_COOLDOWN_HOURS=24
FAUCET_PRIMARY_PRIVATE_KEY=change-me
FAUCET_SECONDARY_PRIVATE_KEY=change-me
TURNSTILE_SITE_KEY=change-me
TURNSTILE_SECRET_KEY=change-me
TURNSTILE_EXPECTED_HOSTNAME=dashboard.registry.haratoken.app
TURNSTILE_EXPECTED_ACTION=faucet_claim
