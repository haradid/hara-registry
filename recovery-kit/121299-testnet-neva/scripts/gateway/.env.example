# Postgres
POSTGRES_DB=hara_tesnet_gateway
POSTGRES_USER=hara_gw
POSTGRES_PASSWORD=<generate-a-random-password>

# JWT / dashboard
JWT_SECRET=<generate-a-32-byte-random-hex>
BOOTSTRAP_ADMIN_EMAIL=<admin-email>
BOOTSTRAP_ADMIN_PASSWORD=<generate-a-random-password>

# validator1 upstream (langsung ke validator1, yang merangkap RPC sejak rpc1 di-retire 2026-08-28 — testnet ini cuma 1 backend RPC primer, tidak ada HAProxy)
RPC_HOST=host.docker.internal
RPC_HTTP_PORT=5797
RPC_WS_PORT=5798

# Public URLs (untuk dashboard display / docs) — via Caddy (HTTPS, domain asli), lihat ../caddy/
GATEWAY_PUBLIC_HTTP_URL=https://rpc.mampang.haratoken.app
GATEWAY_PUBLIC_WS_URL=wss://rpc.mampang.haratoken.app
GATEWAY_PUBLIC_URL=https://dashboard.mampang.haratoken.app

# Faucet (dashboard /faucet page — sends native token directly to validator1 (which merged rpc1's role 2026-08-28), bypasses gateway API-key auth)
FAUCET_PRIVATE_KEY=<FROM-FILE:gateway .env extracted per 00-PRE-TEARDOWN-EXTRACTION.md E15>
FAUCET_DRIP_AMOUNT_ETH=10
FAUCET_COOLDOWN_HOURS=24

# Misc
NODE_ENV=production
CHAIN_ID=121299
