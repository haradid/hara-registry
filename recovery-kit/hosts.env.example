# hosts.env.example — sourceable host/domain variables for recreating the NevaCloud slice on new VPSes.
#
#   mkdir -p ~/hara-ops && cp recovery-kit/hosts.env.example ~/hara-ops/hosts.env
#   set -a; . ~/hara-ops/hosts.env; set +a
#
# Keep the filled copy OUTSIDE the repository clone: it holds live addresses, the repo is mirrored
# publicly, and tools/verify-kit.sh flags any *.env or public IP found under recovery-kit/.
#
# Placeholder <-> variable mapping (the <…_IP> tokens used in the docs and in the copied files):
#   <MAINNET_V3_IP>/<MAINNET_V4_IP>/<MAINNET_V5_IP> -> MAINNET_V{3,4,5}_PUBLIC_IP   <MAINNET_CALL_IP> -> MAINNET_CALL_PUBLIC_IP
#   <MAINNET_GATEWAY_IP> -> MAINNET_GATEWAY_PUBLIC_IP   <MAINNET_V1_AWS_IP> -> MAINNET_HAPROXY_HOST
#   <TESTNET_HOSTB_IP> -> TESTNET_HOSTB_PUBLIC_IP   <TESTNET_HOSTA_IP> -> TESTNET_HOSTA_PUBLIC_IP
#   <EXCHANGE_STG_IP> -> LEDGER_EXCHANGE_PUBLIC_IP   <HALAL_PASSPORT_PROD_IP> -> LEDGER_HALAL_PUBLIC_IP
#   <MAINNET_V2_IP>, <MAINNET_V6_IP>, <MAINNET_V7_IP>, <MAINNET_RPC1_IP>, <MAINNET_ARCHIVE_IP>,
#   <MAINNET_*_SSLIP_HOST>, <*_OLD_IP>, <OLD_ARCHIVE_NEVA_IP>, <NEVA_NET_GATEWAY_IP>: reference only (hosts
#   that stay, or history) — no variable; values in the private Blockchain repo, not needed to rebuild NevaCloud.
#
# Rules
# - Every value is double-quoted: placeholders contain "<", which an unquoted shell would read as a redirect.
# - Each NevaCloud host being replaced is "<SUPPLY:new public IP>" with a "# was …" comment.
# - Mesh IPs keep their current values (internal, reusable). Domains keep their values (DNS is repointed).
# - Dependencies that stay on AWS/Azure are written as <…_IP> placeholders here because this repository is
#   mirrored publicly; their current values are in the private Blockchain repo (mainnet_production/docs,
#   tesnet_server/docs). Fill them in hosts.env, never here.
# - Mesh truth: 10.43.0.0/24 is the WireGuard cross-host mesh. 10.42.0.0/24 is the per-host Docker bridge only
#   and is never a host address. deploy/topology.md (10.42.x, 6 hosts, "hara-stateless") is stale — do not
#   rebuild from it.

# ---------------------------------------------------------------------------------------------------------
# 131216 — Hara Registry ledger (all hosts on NevaCloud, all being replaced)
# ---------------------------------------------------------------------------------------------------------
LEDGER_CHAIN_ID="131216"
LEDGER_MESH_SUBNET="10.43.0.0/24"          # WireGuard mesh (wg0)
LEDGER_DOCKER_BRIDGE="10.42.0.0/24"        # per-host docker bridge only — NOT the mesh, NOT a host address

LEDGER_V1_PUBLIC_IP="<SUPPLY:new public IP>"           # was 202.155.18.234
LEDGER_V1_MESH_IP="10.43.0.11"
LEDGER_V2_PUBLIC_IP="<SUPPLY:new public IP>"           # was 103.169.206.46
LEDGER_V2_MESH_IP="10.43.0.12"
LEDGER_V3_PUBLIC_IP="<SUPPLY:new public IP>"           # was 103.169.206.127
LEDGER_V3_MESH_IP="10.43.0.13"
LEDGER_V4_PUBLIC_IP="<SUPPLY:new public IP>"           # was 160.19.166.23
LEDGER_V4_MESH_IP="10.43.0.14"
LEDGER_RPC1_PUBLIC_IP="<SUPPLY:new public IP>"         # was 103.169.206.237  (hara-rpc-1: rpc-write + rpc-read + HAProxy)
LEDGER_RPC1_MESH_IP="10.43.0.21"
LEDGER_STATELESS2_PUBLIC_IP="<SUPPLY:new public IP>"   # was 103.169.206.239  (hara-stateless-2: services, obs, edge — DNS target)
LEDGER_STATELESS2_MESH_IP="10.43.0.25"
LEDGER_STATEFUL_PUBLIC_IP="<SUPPLY:new public IP>"     # was 103.67.244.250   (hara-stateful: Vault, Postgres, Redis, MinIO)
LEDGER_STATEFUL_MESH_IP="10.43.0.40"
LEDGER_DIDSTG_PUBLIC_IP="<SUPPLY:new public IP>"       # was 103.67.244.109   (hara-did-stg: partner box, own repo)
LEDGER_DIDSTG_MESH_IP="10.43.0.50"
LEDGER_EXCHANGE_PUBLIC_IP="<SUPPLY:new public IP>"     # was <EXCHANGE_STG_IP>        (hara-exchange-stg, not on mesh)
LEDGER_HALAL_PUBLIC_IP="<SUPPLY:new public IP>"        # was <HALAL_PASSPORT_PROD_IP> (halal-passport-prod, Polygon Amoy app, not on mesh)

LEDGER_DOMAIN_RPC="rpc.ledger.haratrust.io"
LEDGER_DOMAIN_EXPLORER="explorer.ledger.haratrust.io"
LEDGER_DOMAIN_TRACE="trace.ledger.haratrust.io"        # trace site + /api-console/* (deploy/edge/Caddyfile)
LEDGER_DOMAIN_GRAFANA="grafana.platform.haratrust.io"
LEDGER_DOMAIN_CONSOLE="console.platform.haratrust.io"
LEDGER_ACME_EMAIL="ops@haratrust.io"
IMAGE_REGISTRY="ghcr.io/imronzuhri-svg/"

# ---------------------------------------------------------------------------------------------------------
# 121212 — HARA Registry mainnet (NevaCloud slice: validator3/4/5, call, gateway host)
# ---------------------------------------------------------------------------------------------------------
MAINNET_CHAIN_ID="121212"
MAINNET_V3_PUBLIC_IP="<SUPPLY:new public IP>"          # was <MAINNET_V3_IP>
MAINNET_V4_PUBLIC_IP="<SUPPLY:new public IP>"          # was <MAINNET_V4_IP>
MAINNET_V5_PUBLIC_IP="<SUPPLY:new public IP>"          # was <MAINNET_V5_IP>
MAINNET_CALL_PUBLIC_IP="<SUPPLY:new public IP>"        # was <MAINNET_CALL_IP>     (hara-mainnet-call: read pool + write failover)
MAINNET_GATEWAY_PUBLIC_IP="<SUPPLY:new public IP>"     # was <MAINNET_GATEWAY_IP>  (gateway + dashboard + Postgres + Redis + nginx)
MAINNET_HAPROXY_HOST="<MAINNET_V1_AWS_IP>"             # validator1 on AWS — stays; fill from the private repo
MAINNET_DOMAIN_RPC="rpc.registry.haratoken.app"
MAINNET_DOMAIN_DASHBOARD="dashboard.registry.haratoken.app"
MAINNET_DOMAIN_EXPLORER="explorer.registry.haratoken.app"

# ---------------------------------------------------------------------------------------------------------
# 121299 — HARA Testnet (NevaCloud slice: Host B)
# ---------------------------------------------------------------------------------------------------------
TESTNET_CHAIN_ID="121299"
TESTNET_HOSTA_PUBLIC_IP="<TESTNET_HOSTA_IP>"           # Host A on AWS (validator1+2, Caddy, netstats) — stays; fill from the private repo
TESTNET_HOSTB_PUBLIC_IP="<SUPPLY:new public IP>"       # was <TESTNET_HOSTB_IP>    (validator3 + gateway + dashboard + Postgres + Redis)
TESTNET_DOMAIN_BASE="mampang.haratoken.app"

# ---------------------------------------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------------------------------------
BACKUP_S3_REMOTE="<SUPPLY:rclone remote name, was nevacloud-s3>"
AGE_RECIPIENT="age1fcdr3qk0wuzxy0ynmzj3d28d8m8pfe489wpk6udstzcyccj7l45sjla6e3"   # public key; private half = ~/.config/age/hara-backups.txt (E2)
